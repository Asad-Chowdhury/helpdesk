# Port the API listens on
PORT=3000

# Comma-separated list of allowed client origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/helpdesk?schema=public

# Better Auth signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this API (used to build callback/redirect URLs)
BETTER_AUTH_URL=http://localhost:3000

# Number of reverse proxies in front of this app (Express `trust proxy`).
# Rate limiting keys on the client IP: too low behind a proxy and every client shares
# one bucket; too high and clients can spoof X-Forwarded-For to evade the limit.
# 0 for local dev (direct connections); typically 1 on Railway.
TRUST_PROXY=0

# ─── Inbound email ──────────────────────────────────────────────────────────
# Domain(s) whose mail becomes tickets, comma-separated. EMPTY DISABLES the webhook
# entirely — the route is not mounted, so an unconfigured deploy has no public
# ingest endpoint rather than one that accepts and discards.
MAIL_DOMAIN=tickets.example.com

# HTTP Basic credentials for the webhook. The provider does not sign Inbound Parse
# requests, so this is the only thing protecting a public write endpoint. Put them in
# the destination URL: https://user:pass@your-api/api/email/inbound
# Generate with: openssl rand -base64 32   (min 32 chars; startup refuses less)
INBOUND_WEBHOOK_USER=inbound
INBOUND_WEBHOOK_PASSWORD=

# Max inbound request size in bytes. Default 35 MB, just above SendGrid's ~30 MB cap.
# INBOUND_MAX_BYTES=36700160

# Require SPF or DKIM to pass. Defaults ON outside development — without it the From
# address is forgeable and "known senders only" secures nothing.
# INBOUND_REQUIRE_AUTH_RESULTS=true
