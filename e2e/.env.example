# Playwright E2E environment. Copy to .env and fill in.

# Test database — created automatically by `bun run db:setup`.
# MUST NOT point at the development database: the suite truncates every table.
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/helpdesk_test?schema=public

# Ports for the servers Playwright boots. Deliberately different from the dev
# ports (3000/5173) so a running dev environment is left alone.
E2E_API_PORT=3001
E2E_WEB_PORT=5174

# Signing secret for the test server only. Not a production secret.
E2E_BETTER_AUTH_SECRET=e2e-only-secret-do-not-use-in-production
